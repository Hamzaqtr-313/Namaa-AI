# ── Core ──
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=true

# ── Database ──
# App runtime connects as a restricted role so Postgres RLS actually applies
# (superusers/owners bypass RLS regardless of FORCE ROW LEVEL SECURITY).
DATABASE_URL=postgresql+asyncpg://namaa_app:namaa_app_dev_password@db:5432/namaa
# Migrations run as the owner/superuser — creates tables, RLS policies, and
# the namaa_app role itself (see alembic/versions/0002_app_role.py).
DATABASE_URL_ADMIN=postgresql+asyncpg://namaa:namaa@db:5432/namaa
APP_DB_PASSWORD=namaa_app_dev_password

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO / S3) ──
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=namaa-documents
S3_REGION=us-east-1

# ── Auth ──
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / LLM (placeholders — fill in when ready) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic

# ── WhatsApp Business Cloud API (placeholders) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# ── Email (placeholders) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993

# ── SMS (placeholders) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
UNIFONIC_APP_SID=

# ── Push notifications (placeholders) ──
FCM_SERVER_KEY=

# ── Encryption ──
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-base64-key-for-fernet
